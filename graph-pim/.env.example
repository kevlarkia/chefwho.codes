# Copy values into the environment. Do not commit real tokens.

# Required for live Graph calls (not for pytest).
# GRAPH_ACCESS_TOKEN=
# Alias accepted by the client:
# AZURE_ACCESS_TOKEN=

# Optional. Include the version suffix. Default: https://graph.microsoft.com/v1.0
# GRAPH_BASE_URL=https://graph.microsoft.com/v1.0

# Optional HTTP timeout in seconds. Default: 30
# GRAPH_TIMEOUT=30
