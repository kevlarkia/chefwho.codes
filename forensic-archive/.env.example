# Copy to .env for local runs. Do not commit real secret values.
# Default provider is dummy (no network, no keys).

FORENSIC_LLM_PROVIDER=dummy

# Anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI (Responses API by default; see official API overview)
# OPENAI_API_KEY=
# OPENAI_ACCESS_TOKEN=
# OPENAI_MODEL=gpt-4.1
# OPENAI_API_SURFACE=responses
# OPENAI_ORGANIZATION=
# OPENAI_PROJECT=
# OPENAI_STORE=false
# OPENAI_MAX_OUTPUT_TOKENS=8192

# Google Vertex
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1
# VERTEX_MODEL=gemini-2.0-flash
# VERTEX_ACCESS_TOKEN=

# FORENSIC_LLM_TIMEOUT=60
