# Copy to .env for local development.
# Do not commit real secret values.

SITE_URL=https://chefwho.codes
CONTACT_RECIPIENT_EMAIL=hello@chefwho.codes
CONTACT_SENDER_EMAIL=no-reply@chefwho.codes
# Optional: enable SendGrid delivery in production.
# CONTACT_SENDGRID_API_KEY=SG.xxxxx
# Optional: adjust in-memory rate limiting window and cap.
# CONTACT_RATE_LIMIT_WINDOW_MS=60000
# CONTACT_RATE_LIMIT_MAX_REQUESTS=5
