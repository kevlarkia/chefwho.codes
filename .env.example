# Copy to .env for local development.
# Do not commit real secret values.

SITE_URL=https://chefwho.codes
CONTACT_RECIPIENT_EMAIL=hello@chefwho.codes
CONTACT_SENDER_EMAIL=no-reply@chefwho.codes
# Optional: enable SendGrid delivery in production.
# CONTACT_SENDGRID_API_KEY=SG.xxxxx
# Optional: adjust in-memory rate limiting window and cap.
# CONTACT_RATE_LIMIT_WINDOW_SECONDS=60
# CONTACT_RATE_LIMIT_MAX_REQUESTS=5

# Stripe Configuration
# Get your test mode keys from https://dashboard.stripe.com/test/apikeys
# Sign up at https://dashboard.stripe.com/register if you don't have an account
# Use test mode keys (sk_test_... and pk_test_...) for development
STRIPE_SECRET_KEY=sk_test_your_actual_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_actual_key_here
STRIPE_API_VERSION=2026-08-26.preview
