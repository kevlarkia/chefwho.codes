# Copy this file to .env and fill in values
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: destination email address used by your own wrappers/scripts
NEWSLETTER_TO_EMAIL=

# Optional: force run on non M/W/F days (1=true, 0=false)
FORCE_EDITION=0

# Optional: skip Gmail draft creation (still calls Gemini)
DRY_RUN=0

# Optional: skip Gemini + Gmail; use local fixtures only
OFFLINE_DRY_RUN=0
